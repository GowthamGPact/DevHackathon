# =========================================================
# DEPLOYMENT VALIDATION
# =========================================================

def deployment_validation():

    separator("DEPLOYMENT VALIDATION")

    validations = [
        "JCL VALIDATION PASSED",
        "PROGRAM NAME VALID",
        "COPYBOOK EXISTS",
        "TEST CASES GENERATED",
        "NO MISSING FILES",
        "BRANCH CREATED"
    ]

    for validation in validations:
        print("[PASS]", validation)


# =========================================================
# FILE DIFF ANALYSIS
# =========================================================

def diff_analysis(jira_id):

    separator("DIFF ANALYSIS")

    folder = f'{CONFIG["output_folder"]}/{jira_id}'

    if not os.path.exists(folder):

        print("No generated files found")
        return

    for file in os.listdir(folder):

        path = os.path.join(folder, file)

        size = os.path.getsize(path)

        print(file, "-", size, "bytes")


# =========================================================
# CLEAN OUTPUT
# =========================================================

def clean_generated():

    separator("CLEANING GENERATED OUTPUT")

    folder = CONFIG["output_folder"]

    if os.path.exists(folder):

        shutil.rmtree(folder)

        print("Generated output removed")

    else:

        print("No generated folder found")


# =========================================================
# MAIN MENU
# =========================================================

def main():

    separator("STORY TO RELEASE AGENT (SRA)")

    jira_id = input("Enter Jira ID: ")

    requirement = input(
        "Enter Requirement: "
    )

    clone_or_pull_repo()

    validate_git()

    branch = create_feature_branch(jira_id)

    while True:

        separator("SELECT ACTION")

        print("1. Repository Analysis")
        print("2. Impact Analysis")
        print("3. Generate COBOL")
        print("4. Generate JCL")
        print("5. Generate Copybook")
        print("6. Generate Test Cases")
        print("7. Generate Documentation")
        print("8. Diff Analysis")
        print("9. Deployment Validation")
        print("10. Commit Changes")
        print("11. Push Branch")
        print("12. PR Summary")
        print("13. Clean Generated Output")
        print("14. Exit")

        choice = input("\nEnter choice: ")

        if choice == "1":

            repository_scan()

        elif choice == "2":

            impact_analysis()

        elif choice == "3":

            generate_cobol(
                jira_id,
                requirement
            )

        elif choice == "4":

            generate_jcl(jira_id)

        elif choice == "5":

            generate_copybook(jira_id)

        elif choice == "6":

            generate_test_cases(jira_id)

        elif choice == "7":

            generate_documentation(
                jira_id,
                requirement
            )

        elif choice == "8":

            diff_analysis(jira_id)

        elif choice == "9":

            deployment_validation()

        elif choice == "10":

            commit_changes(jira_id)

        elif choice == "11":

            push_branch(branch)

        elif choice == "12":

            create_pr_summary(jira_id)

        elif choice == "13":

            clean_generated()

        elif choice == "14":

            print("\nExiting SRA Agent")
            break

        else:

            print("\nInvalid option")


# =========================================================
# START
# =========================================================

if __name__ == "__main__":
    main()