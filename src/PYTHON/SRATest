import os
import json
import subprocess
import shutil
from datetime import datetime

# =========================================================
# LOAD CONFIG
# =========================================================

with open("config.json", "r") as f:
    CONFIG = json.load(f)

# =========================================================
# COMMON UTIL
# =========================================================

def run_command(command, cwd=None):

    result = subprocess.run(
        command,
        shell=True,
        capture_output=True,
        text=True,
        cwd=cwd
    )

    return result.stdout, result.stderr


def separator(title):

    print("\n")
    print("=" * 60)
    print(title)
    print("=" * 60)
    print("\n")


# =========================================================
# REPOSITORY OPERATIONS
# =========================================================

def clone_or_pull_repo():

    repo_url = CONFIG["repo_path"]
    repo_path = CONFIG["local_repo_path"]

    if not os.path.exists(repo_path):

        separator("CLONING REPOSITORY")

        out, err = run_command(
            f"git clone {repo_url} {repo_path}"
        )

        print(out)

        if err:
            print(err)

    else:

        separator("PULLING LATEST CHANGES")

        out, err = run_command(
            "git pull",
            cwd=repo_path
        )

        print(out)

        if err:
            print(err)


def validate_git():

    separator("VALIDATING GIT")

    repo = CONFIG["local_repo_path"]

    out, err = run_command(
        "git branch",
        cwd=repo
    )

    print(out)

    if err:
        print(err)


def create_feature_branch(jira_id):

    separator("CREATING FEATURE BRANCH")

    repo = CONFIG["local_repo_path"]

    branch = f"feature/{jira_id}"

    out, err = run_command(
        f"git checkout -b {branch}",
        cwd=repo
    )

    print(out)

    if err:
        print(err)

    return branch


def commit_changes(jira_id):

    separator("COMMITTING CHANGES")

    repo = CONFIG["local_repo_path"]

    run_command("git add .", cwd=repo)

    out, err = run_command(
        f'git commit -m "{jira_id} automated changes"',
        cwd=repo
    )

    print(out)

    if err:
        print(err)


def push_branch(branch):

    separator("PUSHING BRANCH")

    repo = CONFIG["local_repo_path"]

    out, err = run_command(
        f"git push origin {branch}",
        cwd=repo
    )

    print(out)

    if err:
        print(err)


# =========================================================
# ANALYSIS
# =========================================================

def repository_scan():

    separator("REPOSITORY STANDARD ANALYSIS")

    repo = CONFIG["local_repo_path"]

    cobol_count = 0
    jcl_count = 0
    cpy_count = 0

    for root, dirs, files in os.walk(repo):

        for file in files:

            if file.endswith(".cbl"):

                cobol_count += 1
                print(f"COBOL : {file}")

            elif file.endswith(".jcl"):

                jcl_count += 1
                print(f"JCL   : {file}")

            elif file.endswith(".cpy"):

                cpy_count += 1
                print(f"COPYBOOK : {file}")

    separator("SCAN SUMMARY")

    print("COBOL Programs :", cobol_count)
    print("JCL Files      :", jcl_count)
    print("Copybooks      :", cpy_count)


def impact_analysis():

    separator("IMPACT ANALYSIS")

    impacts = [
        "COPYBOOK IMPACT",
        "FILE LAYOUT IMPACT",
        "DB2 TABLE IMPACT",
        "BUSINESS RULE IMPACT",
        "SCHEDULER IMPACT",
        "DOWNSTREAM BATCH IMPACT",
        "ONLINE TRANSACTION IMPACT"
    ]

    for impact in impacts:
        print("-", impact)


# =========================================================
# CODE GENERATION
# =========================================================

def create_output_folder(jira_id):

    folder = f'{CONFIG["output_folder"]}/{jira_id}'

    os.makedirs(folder, exist_ok=True)

    return folder


def generate_cobol(jira_id, requirement):

    separator("GENERATING COBOL")

    folder = create_output_folder(jira_id)

    program_name = CONFIG["templates"]["batch_program"]

    cobol = f"""
       IDENTIFICATION DIVISION.
       PROGRAM-ID. {program_name}.

       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       01 WS-END            PIC X VALUE 'N'.
       01 WS-MESSAGE        PIC X(50).

       PROCEDURE DIVISION.

           DISPLAY 'SRA PROCESS STARTED'

           MOVE 'PROCESSING INPUT FILE'
           TO WS-MESSAGE

           DISPLAY WS-MESSAGE

           DISPLAY 'REQUIREMENT:'

           DISPLAY '{requirement}'

           DISPLAY 'PROCESS COMPLETED'

           STOP RUN.
    """

    path = f"{folder}/{program_name}.cbl"

    with open(path, "w") as f:
        f.write(cobol)

    print("Generated:", path)


def generate_jcl(jira_id):

    separator("GENERATING JCL")

    folder = create_output_folder(jira_id)

    jcl = f"""
//{jira_id} JOB (123),'SRA'
//*
//STEP01 EXEC PGM=SRABATCH
//STEPLIB DD DSN=LOADLIB,DISP=SHR
//SYSOUT  DD SYSOUT=*
//SYSIN   DD *
/*
    """

    path = f"{folder}/{jira_id}.jcl"

    with open(path, "w") as f:
        f.write(jcl)

    print("Generated:", path)


def generate_copybook(jira_id):

    separator("GENERATING COPYBOOK")

    folder = create_output_folder(jira_id)

    copybook = """
       01 CUSTOMER-RECORD.
          05 CUSTOMER-ID        PIC X(10).
          05 CUSTOMER-NAME      PIC X(30).
          05 CUSTOMER-STATUS    PIC X(01).
    """

    path = f"{folder}/CUSTOMER.cpy"

    with open(path, "w") as f:
        f.write(copybook)

    print("Generated:", path)


