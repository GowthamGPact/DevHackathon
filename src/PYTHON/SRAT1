# =========================================================
# OUTPUT FOLDER
# =========================================================

def create_output_folder(jira_id):

    folder = f'{CONFIG["output_folder"]}/{jira_id}'

    os.makedirs(folder, exist_ok=True)

    return folder


# =========================================================
# COBOL GENERATION
# =========================================================

def generate_cobol(jira_id, requirement):

    separator("GENERATING COBOL")

    folder = create_output_folder(jira_id)

    program_name = CONFIG["templates"]["batch_program"]

    cobol_code = f"""
       IDENTIFICATION DIVISION.
       PROGRAM-ID. {program_name}.

       ENVIRONMENT DIVISION.

       DATA DIVISION.

       WORKING-STORAGE SECTION.

       01 WS-END                PIC X VALUE 'N'.
       01 WS-MESSAGE            PIC X(50).

       PROCEDURE DIVISION.

           DISPLAY 'SRA AUTOMATION STARTED'

           MOVE 'VALIDATING CUSTOMER FILE'
           TO WS-MESSAGE

           DISPLAY WS-MESSAGE

           DISPLAY 'REQUIREMENT:'

           DISPLAY '{requirement}'

           DISPLAY 'PROCESS COMPLETED'

           STOP RUN.
    """

    file_path = f"{folder}/{program_name}.cbl"

    with open(file_path, "w") as f:
        f.write(cobol_code)

    print("GENERATED :", file_path)


# =========================================================
# JCL GENERATION
# =========================================================

def generate_jcl(jira_id):

    separator("GENERATING JCL")

    folder = create_output_folder(jira_id)

    jcl = f"""
//{jira_id} JOB (123),'SRA'
//*
//STEP01 EXEC PGM=SRABATCH
//STEPLIB DD DSN=LOADLIB,DISP=SHR
//SYSOUT  DD SYSOUT=*
//SYSIN   DD *
/*
    """

    file_path = f"{folder}/{jira_id}.jcl"

    with open(file_path, "w") as f:
        f.write(jcl)

    print("GENERATED :", file_path)


