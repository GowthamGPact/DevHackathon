import os
import json
import subprocess
from datetime import datetime

# =========================================================
# LOAD CONFIG
# =========================================================

with open("config.json", "r") as f:
    CONFIG = json.load(f)

# =========================================================
# COMMON UTIL
# =========================================================

def separator(title):

    print("\n")
    print("=" * 60)
    print(title)
    print("=" * 60)
    print("\n")


def run_command(command, cwd=None):

    result = subprocess.run(
        command,
        shell=True,
        capture_output=True,
        text=True,
        cwd=cwd
    )

    if result.stdout:
        print(result.stdout)

    if result.stderr:
        print(result.stderr)

    return result.stdout, result.stderr


# =========================================================
# GIT OPERATIONS
# =========================================================

def clone_or_pull_repo():

    repo_url = CONFIG["repo_path"]
    repo_path = CONFIG["local_repo_path"]

    if not os.path.exists(repo_path):

        separator("CLONING REPOSITORY")

        run_command(
            f"git clone {repo_url} {repo_path}"
        )

    else:

        separator("PULLING LATEST CHANGES")

        run_command(
            "git pull",
            cwd=repo_path
        )


def validate_git():

    separator("VALIDATING GIT")

    repo = CONFIG["local_repo_path"]

    run_command(
        "git branch",
        cwd=repo
    )


def create_branch(branch_name):

    separator(f"CREATING BRANCH : {branch_name}")

    repo = CONFIG["local_repo_path"]

    run_command(
        f"git checkout -b {branch_name}",
        cwd=repo
    )


def commit_changes(commit_message):

    separator("COMMITTING CHANGES")

    repo = CONFIG["local_repo_path"]

    run_command(
        "git add .",
        cwd=repo
    )

    run_command(
        f'git commit -m "{commit_message}"',
        cwd=repo
    )


def push_branch(branch_name):

    separator(f"PUSHING BRANCH : {branch_name}")

    repo = CONFIG["local_repo_path"]

    run_command(
        f"git push origin {branch_name}",
        cwd=repo
    )


# =========================================================
# REPOSITORY ANALYSIS
# =========================================================

def repository_scan():

    separator("REPOSITORY STANDARD ANALYSIS")

    repo = CONFIG["local_repo_path"]

    cobol_count = 0
    jcl_count = 0
    copybook_count = 0

    for root, dirs, files in os.walk(repo):

        for file in files:

            if file.endswith(".cbl"):

                cobol_count += 1
                print("COBOL :", file)

            elif file.endswith(".jcl"):

                jcl_count += 1
                print("JCL :", file)

            elif file.endswith(".cpy"):

                copybook_count += 1
                print("COPYBOOK :", file)

    separator("SCAN SUMMARY")

    print("COBOL FILES :", cobol_count)
    print("JCL FILES :", jcl_count)
    print("COPYBOOKS :", copybook_count)


