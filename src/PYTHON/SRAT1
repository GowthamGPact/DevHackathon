# =========================================================
# PR SUMMARY
# =========================================================

def create_pull_request_summary(
    jira_id,
    source_branch,
    target_branch
):

    separator("PULL REQUEST SUMMARY")

    print("JIRA ID :", jira_id)

    print("\nSOURCE BRANCH :")
    print(source_branch)

    print("\nTARGET BRANCH :")
    print(target_branch)

    print("\nPR TITLE :")
    print(f"{jira_id} Mainframe Enhancement")

    print("\nCHANGES :")
    print("- COBOL Generated")
    print("- JCL Generated")
    print("- Copybook Generated")
    print("- Test Cases Added")
    print("- Deployment Validation Added")

    print("\nSTATUS : READY FOR REVIEW")


# =========================================================
# MAIN FLOW
# =========================================================

def main():

    separator("STORY TO RELEASE AGENT")

    jira_id = input("Enter Jira ID : ")

    requirement = input(
        "Enter Requirement : "
    )

    # STEP 1
    clone_or_pull_repo()

    # STEP 2
    validate_git()

    repo = CONFIG["local_repo_path"]

    # STEP 3
    original_branch = f"{jira_id}-O"

    create_branch(original_branch)

    # STEP 4
    repository_scan()

    impact_analysis()

    # STEP 5
    generate_cobol(jira_id, requirement)

    generate_jcl(jira_id)

    generate_copybook(jira_id)

    generate_test_cases(jira_id)

    generate_documentation(
        jira_id,
        requirement
    )

    deployment_validation()

    diff_analysis(jira_id)

    # STEP 6
    commit_changes(
        f"{jira_id} ORIGINAL IMPLEMENTATION"
    )

    # STEP 7
    push_branch(original_branch)

    # STEP 8
    updated_branch = f"{jira_id}-U"

    create_branch(updated_branch)

    # STEP 9
    simulate_updated_changes(jira_id)

    # STEP 10
    commit_changes(
        f"{jira_id} UPDATED IMPLEMENTATION"
    )

    # STEP 11
    push_branch(updated_branch)

    # STEP 12
    create_pull_request_summary(
        jira_id,
        original_branch,
        updated_branch
    )

    # STEP 13
    separator("READY FOR REVIEW")

    approval = input(
        "Approve Release? (yes/no): "
    )

    if approval.lower() == "yes":

        separator("RELEASE APPROVED")

        print("DEPLOYMENT READY")
        print("PR READY")
        print("PIPELINE COMPLETED")

    else:

        separator("RELEASE REJECTED")

        print("CHANGES REQUIRE MODIFICATION")


# =========================================================
# START
# =========================================================

if __name__ == "__main__":
    main()